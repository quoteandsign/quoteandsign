{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quoteandsign",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*", "/p/*", "/t/*", "/auth/*", "/files/*", "/billing/*", "/terms", "/privacy", "/acceptable-use", "/dpa", "/contact", "/robots.txt", "/sitemap.xml", "/llms.txt", "/compare/*", "/templates", "/templates/*"]
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "quoteandsign.com", "custom_domain": true },
    { "pattern": "www.quoteandsign.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Per-IP limiters that run at the edge, so a scripted client cannot spend database writes.
  "ratelimits": [
    { "name": "BURST", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ONCE", "namespace_id": "1002", "simple": { "limit": 1, "period": 60 } },
    { "name": "BEACON", "namespace_id": "1003", "simple": { "limit": 4, "period": 60 } }
  ],
  "triggers": { "crons": ["0 14 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quoteandsign",
      "database_id": "35358bcb-9fc7-479a-9fda-a2b69c7465f9",
      "migrations_dir": "./drizzle"
    }
  ],
  // Production values. Local development overrides these in .dev.vars (git-ignored).
  "vars": {
    "APP_URL": "https://quoteandsign.com",
    "ENVIRONMENT": "production",
    "EMAIL_FROM": "Quote and Sign <noreply@quoteandsign.com>",
    // ADMIN_EMAILS and SUPPORT_EMAIL are secrets (wrangler secret put), not published here.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEpvqKEqyfNcFF65",
    "POLAR_SERVER": "production",
    "POLAR_PRODUCT_PRO": "09c9f272-be4b-44dc-88d4-76bea4082db5",
    "POLAR_PRODUCT_PRO_YEAR": "a24a854f-2966-4359-90b9-c5918dd94ee0",
    "POLAR_PRODUCT_BUSINESS": "e631dbbf-6ab1-416c-8a33-35d8fa71ebd3",
    "POLAR_PRODUCT_BUSINESS_YEAR": "1a6ff8b6-9ce9-4e93-966c-edae7a07ea92"
  }
}
