{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quoteandsign",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*", "/p/*", "/t/*", "/auth/*", "/files/*", "/billing/*", "/terms", "/privacy", "/acceptable-use", "/dpa", "/contact"]
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "quoteandsign.com", "custom_domain": true },
    { "pattern": "www.quoteandsign.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 14 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quoteandsign",
      "database_id": "35358bcb-9fc7-479a-9fda-a2b69c7465f9",
      "migrations_dir": "./drizzle"
    }
  ],
  // Production values. Local development overrides these in .dev.vars (git-ignored).
  "vars": {
    "APP_URL": "https://quoteandsign.com",
    "ENVIRONMENT": "production",
    "EMAIL_FROM": "Quote and Sign <noreply@quoteandsign.com>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEpvqKEqyfNcFF65"
  }
}
